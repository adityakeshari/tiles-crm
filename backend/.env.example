PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tiles_crm
# Required — the server refuses to start if this is missing or blank.
# Use a long, random, unguessable string (do NOT reuse this example value).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://SERVER_IP,http://SERVER_IP:80
NODE_ENV=production
CRM_OWNER_SUMMARY_API_KEY=replace-with-internal-owner-summary-key
OWNER_SUMMARY_CACHE_TTL_MS=30000
COMPANY_NAME=Tiles CRM Showroom
COMPANY_PHONE=9999999999
COMPANY_ADDRESS=Ujjain, Madhya Pradesh
COMPANY_EMAIL=
COMPANY_GSTIN=
ADMIN_NAME=Launch Admin
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=Admin@123
